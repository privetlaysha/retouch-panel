{
  "manifestVersion": 5,
  "id": "com.kimi.myretouchpanel",
  "name": "My Retouch Panel",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.3.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "myretouchpanel.panel",
      "label": {
        "default": "My Retouch Panel"
      },
      "minimumSize": { "width": 208, "height": 743 },
      "maximumSize": { "width": 208, "height": 743 },
      "preferredDockedSize": { "width": 208, "height": 743 },
      "preferredFloatingSize": { "width": 208, "height": 743 },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icon.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium", "lightest", "light"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icon.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light"],
      "species": ["generic"]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "clipboard": "readAndWrite",
    "launchProcess": {
      "schemes": ["https"],
      "extensions": [".psd"]
    }
  }
}
